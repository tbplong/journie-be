# Copy to .env and fill in. Keep real credentials in .env only, never in this example.

# Google AI Studio key (https://aistudio.google.com/apikey). Required for POST /v1/extractions.
GEMINI_API_KEY=

# Optional overrides; defaults match the benchmarked journie-data configuration.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TEMPERATURE=0.0
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_TIMEOUT_SECONDS=60

# POI retrieval (POST /retrieval): Azure Database for PostgreSQL, e.g.
# postgresql://user:password@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
# Unset: POST /retrieval returns 503 retrieval-not-configured.
DATABASE_URL=
# DATABASE_SCHEMA=public
# DATABASE_POOL_MAX_SIZE=3
# DATABASE_TIMEOUT_SECONDS=10
# Set true when connecting through Azure's built-in PgBouncer (port 6432).
# DATABASE_PGBOUNCER=false
