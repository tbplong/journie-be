# Copy to .env and fill in. Keep real credentials in .env only, never in this example.

# Google AI Studio key (https://aistudio.google.com/apikey). Required for POST /v1/extractions.
GEMINI_API_KEY=

# Optional overrides; defaults match the benchmarked journie-data configuration.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TEMPERATURE=0.0
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_TIMEOUT_SECONDS=60
